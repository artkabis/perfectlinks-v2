{
  "name": "perfectlinks-api",
  "version": "2.0.0",
  "description": "API backend professionnelle pour l'analyse de maillage interne de sites web avec PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=3500 server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate-json-to-postgres.js",
    "migrate:check": "node scripts/check-migration.js",
    "db:setup": "node scripts/setup-database.js",
    "db:reset": "node scripts/reset-database.js",
    "db:grant": "node scripts/grant-permissions.js",
    "db:diagnose": "node scripts/diagnose-db-user.js",
    "db:fix-owner": "node scripts/change-table-owner.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/api.integration.test.js",
    "test:api": "./test-api.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "seo",
    "sitemap",
    "internal-links",
    "web-scraping",
    "api",
    "postgresql",
    "jwt",
    "authentication"
  ],
  "author": "Artkabis <contact@artkabis.fr>",
  "license": "MIT",
  "dependencies": {
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "undici": "4.15.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
