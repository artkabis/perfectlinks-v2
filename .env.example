# Environment
NODE_ENV=development
PORT=9090

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=perfectlinks_db
DB_USER=perfectlinks_user
DB_PASSWORD=your_secure_password_here

# JWT Secret Keys
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secure_refresh_token_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Legacy JSON System (for migration only)
JWT_SECRET_JSON=your_old_json_encryption_key
USERS_PATH_ENCRYPT=./data/users.encrypted.json

# Usage Plans (requests per month)
FREE_PLAN=100
PREMIUM_PLAN=500
PRO_PLAN=1000

# Email Configuration (SMTP)
MAILSENDER_USERNAME=noreply@perfectlinks.fr
MAILSENDER_HOST=smtp.example.com
MAILSENDER_PORT=587
MAILSENDER_PASSWORD=your_smtp_password
MAILSENDER_SECURE=false
MAILSENDER_FROM=Perfect Links <noreply@perfectlinks.fr>

# Email Validation
EMAIL_VALIDATION_URL=https://perfectlinksapi.artkabis.fr/api/validate-account

# CORS Configuration
CORS_ORIGIN=https://perfectlinks.artkabis.fr
# For multiple origins use comma-separated values:
# CORS_ORIGIN=https://perfectlinks.artkabis.fr,https://app.perfectlinks.fr

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Crawling Configuration
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=10000
USER_AGENT=PerfectLinks Bot/2.0 (+https://perfectlinks.artkabis.fr)
