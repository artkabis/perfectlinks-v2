# Passenger désactivé - Gestion manuelle avec PM2
PassengerEnabled off

# Headers CORS - Set first so they apply to all responses
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "https://app.perfectlinksv2.artkabis.fr"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, PATCH, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, x-custom-data, X-Requested-With, Authorization"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Handle OPTIONS preflight requests directly (don't proxy them)
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Reverse proxy vers l'application Node.js sur localhost:9090
RewriteCond %{HTTPS} on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ http://127.0.0.1:9090/$1 [P,L]

# Protection fichiers sensibles
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(package\.json|\.env|\.git|node_modules)">
    Require all denied
</FilesMatch>
