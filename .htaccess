# Passenger désactivé - Gestion manuelle avec PM2
PassengerEnabled off

# Reverse proxy vers l'application Node.js sur localhost:9090
# Les headers CORS sont gérés par l'application Node.js (voir server.js)
RewriteEngine On
RewriteCond %{HTTPS} on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ http://127.0.0.1:9090/$1 [P,L]

# Protection fichiers sensibles
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(package\.json|\.env|\.git|node_modules)">
    Require all denied
</FilesMatch>
