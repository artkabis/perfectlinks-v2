# Passenger désactivé - Gestion manuelle avec PM2
PassengerEnabled off

# Reverse proxy vers l'application Node.js sur localhost:9090
RewriteEngine On
RewriteCond %{HTTPS} on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ http://127.0.0.1:9090/$1 [P,L]

# Headers CORS (use 'set' instead of 'always set' to avoid duplicates)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://app.perfectlinksv2.artkabis.fr"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, PATCH, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, x-custom-data, X-Requested-With, Authorization"
    Header set Access-Control-Allow-Credentials "true"
    Header set Access-Control-Max-Age "86400"
</IfModule>

# Protection fichiers sensibles
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(package\.json|\.env|\.git|node_modules)">
    Require all denied
</FilesMatch>
