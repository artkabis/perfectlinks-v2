# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerEnabled on
PassengerFriendlyErrorPages on
PassengerAppRoot /home/nigr8844/perfectlinksv2.artkabis.fr
PassengerStartupFile server.js
PassengerAppType node
PassengerNodejs /home/nigr8844/nodevenv/perfectlinksv2.artkabis.fr/16/bin/node
PassengerAppEnv production

# Increase startup timeout from 90s to 300s (5 minutes)
PassengerStartTimeout 300

# Application logging
PassengerAppLogFile /home/nigr8844/perfectlinksv2.log

# Memory and process limits
PassengerMaxPoolSize 2
PassengerMinInstances 1
PassengerMaxInstancesPerApp 2
PassengerMaxRequests 1000

# Enable better error reporting
PassengerBufferResponse off
PassengerResponseBufferHighWatermark 0
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# CORS Headers
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "https://app.perfectlinksv2.artkabis.fr"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, PATCH, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, x-custom-data, X-Requested-With, Authorization"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Max-Age "86400"

    # Force HTML response for better error visibility
    Header always set Content-Type "text/html; charset=utf-8" "expr=%{CONTENT_TYPE} =~ m#^$#"
</IfModule>

# Protection fichiers sensibles
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(package\.json|\.env|\.git|node_modules)">
    Require all denied
</FilesMatch>
