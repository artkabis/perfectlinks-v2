{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "consistent-return": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-param-reassign": ["error", { "props": false }],
    "max-len": ["warn", { "code": 120, "ignoreComments": true }]
  }
}
