# ==============================================================================
# Configuration pour test LOCAL - Perfect Links API
# ==============================================================================
# Ce fichier contient une configuration prête à l'emploi pour tester en local.
# Copier ce fichier en .env pour démarrer rapidement :
# cp .env.local.example .env
# ==============================================================================

# Environment
NODE_ENV=development
PORT=9090

# ==============================================================================
# PostgreSQL - Configuration locale
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=perfectlinks_db
DB_USER=perfectlinks_user
DB_PASSWORD=perfectlinks2024

# ==============================================================================
# JWT - Secrets pour développement LOCAL uniquement
# ⚠️ ATTENTION: Ne JAMAIS utiliser ces clés en production !
# ==============================================================================
JWT_SECRET=local_dev_jwt_secret_key_not_for_production
JWT_REFRESH_SECRET=local_dev_refresh_secret_key_not_for_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# Plans - Quotas de requêtes par mois
# ==============================================================================
FREE_PLAN=100
PREMIUM_PLAN=500
PRO_PLAN=1000

# ==============================================================================
# Email - Configuration factice pour test local
# Les emails ne seront pas envoyés, mais l'app ne plantera pas
# ==============================================================================
MAILSENDER_USERNAME=test@localhost
MAILSENDER_HOST=localhost
MAILSENDER_PORT=587
MAILSENDER_PASSWORD=test
MAILSENDER_SECURE=false
MAILSENDER_FROM=Perfect Links <noreply@localhost>

# URL de validation (pour test local)
EMAIL_VALIDATION_URL=http://localhost:9090/api/validate-account

# ==============================================================================
# CORS - Autoriser toutes les origines en développement
# ==============================================================================
CORS_ORIGIN=*

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# ==============================================================================
# Crawling - Configuration pour l'analyse de sitemap
# ==============================================================================
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=10000
USER_AGENT=PerfectLinks Bot/2.0 (Local Development)

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Pour créer la base de données PostgreSQL, exécutez :
#    sudo -u postgres psql
#    CREATE DATABASE perfectlinks_db;
#    CREATE USER perfectlinks_user WITH ENCRYPTED PASSWORD 'perfectlinks2024';
#    GRANT ALL PRIVILEGES ON DATABASE perfectlinks_db TO perfectlinks_user;
#    \q
#
# 2. Pour créer les tables :
#    npm run db:setup
#
# 3. Pour démarrer le serveur :
#    npm run dev
#
# 4. Pour tester l'API :
#    ./test-local.sh
# ==============================================================================
